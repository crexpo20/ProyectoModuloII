  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Cargar DimCliente"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{EDBACF54-4880-4616-80B8-576A9F8A84E0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Cargar DimCliente"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D8438BAD-6FD3-4366-8B32-282F1EE2C702}"
          SQLTask:SqlStatementSource="&#xA;USE NorthwindDW;&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;-- Actualizar los clientes que ya existen.&#xA;UPDATE D&#xA;SET&#xA;    D.Empresa = S.CompanyName,&#xA;    D.Contacto = S.ContactName,&#xA;    D.CargoContacto = S.ContactTitle,&#xA;    D.Ciudad = S.City,&#xA;    D.Region = S.Region,&#xA;    D.CodigoPostal = S.PostalCode,&#xA;    D.Pais = S.Country&#xA;FROM dbo.DimCliente AS D&#xA;INNER JOIN NorthWindF.dbo.Customers AS S&#xA;    ON D.CustomerID = S.CustomerID;&#xA;&#xA;-- Insertar solamente los clientes nuevos.&#xA;INSERT INTO dbo.DimCliente&#xA;(&#xA;    CustomerID,&#xA;    Empresa,&#xA;    Contacto,&#xA;    CargoContacto,&#xA;    Ciudad,&#xA;    Region,&#xA;    CodigoPostal,&#xA;    Pais&#xA;)&#xA;SELECT&#xA;    S.CustomerID,&#xA;    S.CompanyName,&#xA;    S.ContactName,&#xA;    S.ContactTitle,&#xA;    S.City,&#xA;    S.Region,&#xA;    S.PostalCode,&#xA;    S.Country&#xA;FROM NorthWindF.dbo.Customers AS S&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimCliente AS D&#xA;    WHERE D.CustomerID = S.CustomerID&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
