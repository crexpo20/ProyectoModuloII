  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Cargar DimFecha"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{1738CB63-1AB7-4FDC-B0D4-FAF8721C771F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Cargar DimFecha"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{70DA8497-9421-43E8-811C-0AB6BF3BB99A}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @FechaInicio DATE;&#xA;DECLARE @FechaFin DATE;&#xA;&#xA;SELECT&#xA;    @FechaInicio = MIN(Fecha),&#xA;    @FechaFin = MAX(Fecha)&#xA;FROM&#xA;(&#xA;    SELECT CAST(OrderDate AS DATE) AS Fecha&#xA;    FROM NorthWindF.dbo.Orders&#xA;    WHERE OrderDate IS NOT NULL&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT CAST(RequiredDate AS DATE)&#xA;    FROM NorthWindF.dbo.Orders&#xA;    WHERE RequiredDate IS NOT NULL&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT CAST(ShippedDate AS DATE)&#xA;    FROM NorthWindF.dbo.Orders&#xA;    WHERE ShippedDate IS NOT NULL&#xA;) AS FechasOrigen;&#xA;&#xA;IF @FechaInicio IS NULL&#xA;BEGIN&#xA;    THROW 50001, 'No existen fechas de pedidos en NorthWindF.', 1;&#xA;END;&#xA;&#xA;;WITH Calendario AS&#xA;(&#xA;    SELECT @FechaInicio AS Fecha&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT DATEADD(DAY, 1, Fecha)&#xA;    FROM Calendario&#xA;    WHERE Fecha &lt; @FechaFin&#xA;)&#xA;INSERT INTO dbo.DimFecha&#xA;(&#xA;    FechaKey,&#xA;    Fecha,&#xA;    Dia,&#xA;    Mes,&#xA;    NombreMes,&#xA;    Trimestre,&#xA;    Anio,&#xA;    DiaSemana,&#xA;    NombreDia,&#xA;    EsFinDeSemana&#xA;)&#xA;SELECT&#xA;    CONVERT(INT, CONVERT(CHAR(8), C.Fecha, 112)),&#xA;    C.Fecha,&#xA;    DAY(C.Fecha),&#xA;    MONTH(C.Fecha),&#xA;    CASE MONTH(C.Fecha)&#xA;        WHEN 1 THEN N'Enero'&#xA;        WHEN 2 THEN N'Febrero'&#xA;        WHEN 3 THEN N'Marzo'&#xA;        WHEN 4 THEN N'Abril'&#xA;        WHEN 5 THEN N'Mayo'&#xA;        WHEN 6 THEN N'Junio'&#xA;        WHEN 7 THEN N'Julio'&#xA;        WHEN 8 THEN N'Agosto'&#xA;        WHEN 9 THEN N'Septiembre'&#xA;        WHEN 10 THEN N'Octubre'&#xA;        WHEN 11 THEN N'Noviembre'&#xA;        WHEN 12 THEN N'Diciembre'&#xA;    END,&#xA;    DATEPART(QUARTER, C.Fecha),&#xA;    YEAR(C.Fecha),&#xA;    (DATEDIFF(DAY, CONVERT(DATE, '19000101'), C.Fecha) % 7) + 1,&#xA;    CASE&#xA;        ((DATEDIFF(DAY, CONVERT(DATE, '19000101'), C.Fecha) % 7) + 1)&#xA;        WHEN 1 THEN N'Lunes'&#xA;        WHEN 2 THEN N'Martes'&#xA;        WHEN 3 THEN N'Miércoles'&#xA;        WHEN 4 THEN N'Jueves'&#xA;        WHEN 5 THEN N'Viernes'&#xA;        WHEN 6 THEN N'Sábado'&#xA;        WHEN 7 THEN N'Domingo'&#xA;    END,&#xA;    CASE&#xA;        WHEN ((DATEDIFF(DAY, CONVERT(DATE, '19000101'), C.Fecha) % 7) + 1)&#xA;             IN (6, 7)&#xA;        THEN 1&#xA;        ELSE 0&#xA;    END&#xA;FROM Calendario AS C&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimFecha AS D&#xA;    WHERE D.Fecha = C.Fecha&#xA;)&#xA;OPTION (MAXRECURSION 0);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
