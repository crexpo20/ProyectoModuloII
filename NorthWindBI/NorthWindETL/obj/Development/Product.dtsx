      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{94C7B1FC-8091-4A1C-97F4-62065CE9EB68}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.Staging_Products;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
