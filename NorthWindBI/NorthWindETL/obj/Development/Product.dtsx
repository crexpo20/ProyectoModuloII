    <DTS:Executable
      DTS:refId="Package\Execute MERGE Products"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{F6BB657C-65C5-435B-AC1B-83BB51521642}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute MERGE Products"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{94C7B1FC-8091-4A1C-97F4-62065CE9EB68}"
          SQLTask:SqlStatementSource="MERGE INTO NorthWindOLAP.dbo.Products AS Target&#xA;USING NorthWindOLAP.dbo.Staging_Products AS Source&#xA;ON Target.Id = Source.Id&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET Target.RowVersion = Source.RowVersion&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (Id, RowVersion)&#xA;    VALUES (Source.Id, Source.RowVersion);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
