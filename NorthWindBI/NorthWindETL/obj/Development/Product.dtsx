      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8C3E42C0-5084-45B4-AA69-74DF45BBC160}"
          SQLTask:SqlStatementSource="SELECT CONVERT(BIGINT, ISNULL(MAX(RowVersion), 0x0000000000000000)) AS MaxRowVersion &#xA;FROM dbo.Products;"
